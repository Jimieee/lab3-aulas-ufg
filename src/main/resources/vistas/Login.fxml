<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="620.0" prefWidth="640.0"
           style="-fx-background-color: #f3f6f9;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="edu.ufg.aulas.controladores.LoginController">
    <children>
        <VBox alignment="CENTER_LEFT" maxWidth="390.0" spacing="14.0"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #d9e0e7; -fx-border-radius: 12;">
            <padding>
                <Insets bottom="34.0" left="38.0" right="38.0" top="34.0" />
            </padding>
            <children>
                <Label text="UFG · Registro de aulas"
                       style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" />
                <Label text="Iniciar sesión"
                       style="-fx-font-size: 16px; -fx-text-fill: #5f6b76;" />
                <Label labelFor="$txtCorreo" text="Correo electrónico"
                       style="-fx-font-weight: bold;" />
                <TextField fx:id="txtCorreo" maxWidth="Infinity"
                           promptText="correo@ufg.edu" />
                <Label labelFor="$txtClave" text="Contraseña"
                       style="-fx-font-weight: bold;" />
                <PasswordField fx:id="txtClave" maxWidth="Infinity"
                               promptText="Ingrese su contraseña" />
                <Button fx:id="btnIngresar" defaultButton="true" maxWidth="Infinity"
                        onAction="#ingresar" text="Ingresar"
                        style="-fx-background-color: #1f5f8b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18;" />
                <Label fx:id="lblMensaje" maxWidth="Infinity" textFill="#c62828" wrapText="true" />
            </children>
        </VBox>
    </children>
</StackPane>

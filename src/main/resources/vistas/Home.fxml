<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="620.0" prefWidth="640.0" spacing="16.0"
      style="-fx-background-color: #f3f6f9;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.ufg.aulas.controladores.HomeController">
    <padding>
        <Insets bottom="24.0" left="32.0" right="32.0" top="24.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <children>
                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Registro de aulas"
                               style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: #1f3b57;" />
                        <Label fx:id="lblBienvenida" text="Bienvenido"
                               style="-fx-text-fill: #5f6b76;" wrapText="true" />
                    </children>
                </VBox>
                <Button fx:id="btnCerrarSesion" onAction="#cerrarSesion" text="Cerrar sesión"
                        style="-fx-background-color: transparent; -fx-border-color: #9aa8b5; -fx-border-radius: 5;" />
            </children>
        </HBox>

        <VBox spacing="14.0"
              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #d9e0e7; -fx-border-radius: 10;"
              VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="22.0" left="26.0" right="26.0" top="22.0" />
            </padding>
            <children>
                <Label text="Datos del aula"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #263746;" />
                <GridPane hgap="16.0" vgap="11.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="125.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <children>
                        <Label labelFor="$txtNombre" text="Nombre / código" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNombre" promptText="B-204"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label labelFor="$txtEdificio" text="Edificio" GridPane.rowIndex="1" />
                        <TextField fx:id="txtEdificio" promptText="Edificio B"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label labelFor="$cbPlanta" text="Planta" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cbPlanta" maxWidth="Infinity" promptText="Seleccione una planta"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label labelFor="$txtCapacidad" text="Capacidad" GridPane.rowIndex="3" />
                        <TextField fx:id="txtCapacidad" promptText="30"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label labelFor="$cbTipoAula" text="Tipo de aula" GridPane.rowIndex="4" />
                        <ComboBox fx:id="cbTipoAula" maxWidth="Infinity" promptText="Seleccione un tipo"
                                  GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label labelFor="$txtResponsable" text="Responsable" GridPane.rowIndex="5" />
                        <TextField fx:id="txtResponsable" promptText="Nombre del responsable"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label labelFor="$cbEstado" text="Estado" GridPane.rowIndex="6" />
                        <ComboBox fx:id="cbEstado" maxWidth="Infinity" promptText="Seleccione un estado"
                                  GridPane.columnIndex="1" GridPane.rowIndex="6" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnLimpiar" onAction="#limpiar" text="Limpiar"
                                style="-fx-background-color: #eef2f5; -fx-text-fill: #263746;" />
                        <Button fx:id="btnGuardar" onAction="#guardar" text="Guardar"
                                style="-fx-background-color: #1f5f8b; -fx-text-fill: white; -fx-font-weight: bold;" />
                    </children>
                </HBox>
                <Label fx:id="lblMensaje" maxWidth="Infinity" wrapText="true" />
            </children>
        </VBox>
    </children>
</VBox>
